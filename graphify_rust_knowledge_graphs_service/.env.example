# Port the HTTP server listens on (default: 3000)
PORT=3000

# Log level: error | warn | info | debug | trace (default: info)
RUST_LOG=info

# ── LLM keys (only needed when calling build with ?use_llm=true) ──────────────

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Per-graph LLM config: drop a graphify.toml into data/<graph-name>/
# See: https://github.com/TtTRz/graphify-rs/blob/main/docs/CLI.md#configuration-graphifytoml
