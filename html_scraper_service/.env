# =============================================================================
# Scraper Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=3737

# Allowed CORS origin (use * for development, lock down in production)
# Example: CORS_ORIGIN=tauri://localhost
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

# Directory where markdown files are written.
# Structure: <OUTPUT_DIR>/<category>/<article-title>.md
OUTPUT_DIR=D:\Github\worldmonitor-apps\html_scraper_service\markdown

# ---------------------------------------------------------------------------
# Scraping behaviour
# ---------------------------------------------------------------------------

# Max number of URLs processed concurrently
MAX_CONCURRENCY=3

# Playwright navigation timeout in milliseconds
BROWSER_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Firecrawl (fallback when Playwright fails)
# Get your API key at https://firecrawl.dev
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=fc-3c2677e6221e4893aff7f02eb5886b45

MAX_RETRIES=
LOG_LEVEL=
PROXY_URL=